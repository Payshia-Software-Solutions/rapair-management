# Nexus portal UI settings. Copy to nexus-portal-ui/.env.local and fill in.
# NEXT_PUBLIC_* values are built into the browser bundle, so never put secrets here.
# Leave a value blank to use the default (computed from the current browser address).

# Nexus portal API root, WITH /api. Local: http://localhost/rapair-management/nexus-portal-server/public/api
# Production: https://api-saas.nebulync.com/api
NEXT_PUBLIC_API_URL=

# Public address of this UI (used for links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
