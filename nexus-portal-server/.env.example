# Nexus portal settings. Copy to nexus-portal-server/.env (gitignored) and fill in.
# Read by app/Core/Config.php (defaults apply to anything left blank) and public/index.php.
# This file has no secrets: it is only a template.

# ---- Database (the master database: tenants, packages, invoices, products)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=

# ---- Public address of the portal UI (links in emails, verification links)
SITE_URL=http://localhost:3000

# ---- Who may call this API with the admin session cookie (comma separated; no trailing slashes).
# Local default: http://localhost:3000,http://127.0.0.1:3000,http://localhost:9003
NEXUS_ALLOWED_ORIGINS=
# Lax when the UI and this API share one site. None (needs HTTPS) when they are on different sites,
# otherwise login appears to succeed and then drops back to the login page.
NEXUS_COOKIE_SAMESITE=Lax

# ---- Email. MAIL_DISABLED=true saves mail to scratch/mail_outbox/ instead of sending (local only, never in production)
MAIL_DISABLED=false
# SMTP is set in the admin panel (Settings > Mail), stored in saas_settings. Nothing to put here.
# Optional fallback, used only when the admin panel has no value yet:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=BizzFlow
# SMTP_FROM_EMAIL=

# ---- Custom domains: the host customers point their domain at (a CNAME). Normally the workspace server's host.
CUSTOM_DOMAIN_TARGET=
# false skips the DNS check. Local testing only.
CUSTOM_DOMAIN_DNS_CHECK=true

# ================================================================ Must match the ERP server (server/.env)
# Nexus (Admin -> Products)        ERP server/.env
# ----------------------------------------------------------------
# Provisioning URL                 the ERP's /provision.php address
# Webhook secret                   TENANCY_WEBHOOK_SECRET
# (each workspace's) API key       that workspace's NEXUS_API_KEY / the key shown on its Subscription page
# CUSTOM_DOMAIN_TARGET             the host serving TENANCY_BASE_DOMAIN
# The ERP's NEXUS_PORTAL_URL is this API root without /api, e.g. https://api-saas.example.com
