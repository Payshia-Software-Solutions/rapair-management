# API Configuration
NEXT_PUBLIC_API_URL=http://localhost/rapair-management/server/public

# Shared (multi-tenant) deployment only. Leave unset for a single-client install.
#   shared -> the workspace is the domain the app is open on (<slug>.<base domain> or a custom domain);
#             NEXT_PUBLIC_API_URL is the shared API host (e.g. https://api.bizzflow.nebulync.com/server/public)
# NEXT_PUBLIC_TENANT_MODE=shared
# NEXT_PUBLIC_TENANT_BASE_DOMAIN=bizzflow.nebulync.com

# Content/Media Provider Configuration
NEXT_PUBLIC_CONTENT_BASE_URL=https://content-provider.payshia.com/service-center-system/

# AI API Keys (Optional)
GOOGLE_GENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

