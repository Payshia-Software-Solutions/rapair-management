{
  "name": "bizzflow-printer",
  "version": "2.0.0",
  "description": "BizzFlow silent print bridge for POS / KOT thermal printers",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "icon": "node scripts/make-icon.js",
    "build": "pkg . --targets node18-win-x64 --output bizzflow-printer.exe && node scripts/hide-console.js bizzflow-printer.exe",
    "installer": "node scripts/build-installer.js",
    "release": "npm run build && npm run installer"
  },
  "pkg": {
    "assets": [
      "ui/**/*",
      "assets/**/*",
      "node_modules/pdf-to-printer/dist/SumatraPDF-3.4.6-32.exe",
      "node_modules/systray2/traybin/tray_windows_release.exe"
    ]
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pdf-to-printer": "latest",
    "puppeteer-core": "^22.6.0",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
