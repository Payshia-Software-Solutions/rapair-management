# Server settings. Copy to server/.env (gitignored) and fill in. Read by config/config.php.
# This file has no secrets: it is only a template.

# single = one customer, one database (client install / local development)
# shared = many workspaces on one server (the BizzFlow SaaS deployment)
APP_MODE=single

APP_TIMEZONE=Asia/Colombo
URLROOT=http://localhost/rapair-management/server
SITENAME=Repair Management API
GOOGLE_CLIENT_ID=

# Nexus portal API root WITHOUT /api. Local Nexus: http://localhost/rapair-management/nexus-portal-server/public
NEXUS_PORTAL_URL=https://api-saas.nebulync.com

# Content server (CDN). Uploaded files go to its FTP when FTP_* is set; leave FTP_* unset in development.
CONTENT_BASE_URL=https://content-provider.payshia.com/service-center-system/
# FTP_HOST=
# FTP_PORT=21
# FTP_USER=
# FTP_PASS=

# ---------------------------------------------------------------- APP_MODE=single
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=
# Generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ISSUER=repair-management
JWT_TTL_SECONDS=28800
# Licence from the Nexus portal (this client's key)
NEXUS_API_KEY=
NEXUS_LICENSE_KEY=

# ---------------------------------------------------------------- APP_MODE=shared
# Workspace registry database (holds no business data)
TENANCY_CONTROL_DB_HOST=localhost
TENANCY_CONTROL_DB_NAME=
TENANCY_CONTROL_DB_USER=
TENANCY_CONTROL_DB_PASS=
# Both: php -r "echo bin2hex(random_bytes(32));"   MASTER_KEY must never change once a workspace exists.
TENANCY_MASTER_KEY=
# MUST EQUAL the webhook secret of this product in Nexus (Admin -> Products)
TENANCY_WEBHOOK_SECRET=
# Workspaces open at <name>.<base domain>. MUST MATCH the domain Nexus shows customers
# (and Nexus CUSTOM_DOMAIN_TARGET points at this server).
TENANCY_BASE_DOMAIN=bizzflow.nebulync.com
# API host(s) shared by all workspaces (comma separated); the workspace comes from the X-Tenant-Host header
TENANCY_API_HOSTS=api.bizzflow.nebulync.com
# Local only, e.g. http://{slug}.localhost:9010
# TENANCY_APP_URL_TEMPLATE=
# Where workspace databases are created: cpanel (shared hosting) or mysql (VPS / managed MySQL)
TENANCY_DB_DRIVER=cpanel
TENANCY_TENANT_DB_HOST=localhost
# cpanel driver
# TENANCY_CPANEL_URL=https://yourdomain.com:2083
# TENANCY_CPANEL_USER=
# TENANCY_CPANEL_TOKEN=
# mysql driver (an account allowed to CREATE DATABASE / CREATE USER / GRANT)
# TENANCY_DB_ADMIN_HOST=localhost
# TENANCY_DB_ADMIN_USER=
# TENANCY_DB_ADMIN_PASS=
# TENANCY_DB_USER_HOST=localhost
