# Shared (multi-tenant) server settings. Copy to server/.env on the SHARED server and fill in.
# Only the shared deployment (BizzFlow SaaS). Client single installs use .env.example instead.
# Secrets must never be committed. Keep the real .env on the server only.

APP_MODE=shared
APP_TIMEZONE=Asia/Colombo
SITENAME=BizzFlow API
# Public API root. Tenants get their own subdomain, the API host is in TENANCY_API_HOSTS.
URLROOT=https://api.bizzflow.nebulync.com
# Nexus portal API root WITHOUT /api
NEXUS_PORTAL_URL=https://api-saas.nebulync.com
GOOGLE_CLIENT_ID=

# Content server (CDN). Each workspace gets <root>/t/<slug>/
CONTENT_BASE_URL=https://content-provider.payshia.com/service-center-system/

# ---------------------------------------------------------------- Control database
# Workspace registry only (tenants, domains). Holds no business data.
# Create it in cPanel > MySQL Databases first.
TENANCY_CONTROL_DB_HOST=localhost
TENANCY_CONTROL_DB_NAME=cpaneluser_control
TENANCY_CONTROL_DB_USER=cpaneluser_control
TENANCY_CONTROL_DB_PASS=

# ---------------------------------------------------------------- Secrets
# Generate each with: php -r "echo bin2hex(random_bytes(32));"
# MASTER_KEY encrypts tenant DB passwords. NEVER change it once a workspace exists.
TENANCY_MASTER_KEY=
# Must equal the webhook secret of this produc  t in Nexus (Admin -> Products)
TENANCY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Domains
# Workspaces open at <slug>.<base domain>. Must match the domain Nexus shows customers.
TENANCY_BASE_DOMAIN=bizzflow.nebulync.com
# API host(s) shared by all workspaces (comma separated). Workspace comes from the X-Tenant-Host header.
TENANCY_API_HOSTS=api-erp.nebulync.com

# ---------------------------------------------------------------- Tenant DB driver: cPanel
# Tenant databases and users are created with the cPanel UAPI (API token).
TENANCY_DB_DRIVER=cpanel
TENANCY_TENANT_DB_HOST=localhost
TENANCY_CPANEL_URL=https://yourdomain.com:2083
TENANCY_CPANEL_USER=cpanelusername
TENANCY_CPANEL_TOKEN=

# ---------------------------------------------------------------- Tenant DB driver: mysql (VPS / managed MySQL)
# Use INSTEAD of the cPanel block above. Set TENANCY_DB_DRIVER=mysql.
# TENANCY_DB_DRIVER=mysql
# TENANCY_TENANT_DB_HOST=localhost
# TENANCY_DB_ADMIN_HOST=localhost
# TENANCY_DB_ADMIN_USER=
# TENANCY_DB_ADMIN_PASS=
# TENANCY_DB_USER_HOST=localhost

# Local development only
# TENANCY_APP_URL_TEMPLATE=http://{slug}.localhost:9010
