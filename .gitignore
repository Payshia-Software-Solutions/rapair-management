# ---- Secrets and per-machine config
# Copy the *.example files and fill them in on each machine. Never commit the real ones.
.env
.env.*
!.env.example
!.env.shared.example
/server/config/config.php
*.pem

# ---- Dependencies and build output
# server/vendor is not tracked: run `composer install` on the server after deploy.
# nexus-portal-server/vendor stays tracked: cPanel deploys it (no composer there).
server/vendor/
node_modules/
.next/
.next-shared/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# ---- Logs and debug output
*.log
/server/logs/
/server/debug_api.log

# ---- Runtime data (files belong on the FTP content server, not in git)
/server/public/uploads/
/server/scratch/tenants/
/server/scratch/tenancy/
/server/scratch/*.json
/nexus-portal-server/scratch/mail_outbox/

# ---- Desktop POS build output
/desktop_pos/bin/
/desktop_pos/obj/
/desktop_pos/.wix/
/desktop_pos/*.msi
/desktop_pos/*.wixpdb
/desktop_pos/*_log.txt
/desktop_pos/build_out.txt

# ---- Local printer helper (see README in that folder)
/local-printer
/local-printer-py
bizzflow-printer-v9.exe

# ---- Tooling cache and IDE/OS files
graphify-out/cache/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Database backups (never commit)
server/storage/backups/

# Database dumps stay out of git (clean_database_template.sql is still tracked: the provisioner needs it)
server/database.sql
server/database_new.sql
server/repair_management_db_dump.sql
server/seed_packages.sql

# Runtime state written by the API (dev mode, license cache, usage timestamps)
/server/scratch/

# graphify build state and dated snapshots (the graph itself stays tracked)
graphify-out/.graphify_build_state.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_labels.pending.json
graphify-out/20*/
